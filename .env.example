# ============================================================================
# Freelancezero — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# --- Core ---
# Public base URL of the app (used for callbacks, emails, magic links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL) ---
# In Docker Compose this points at the `db` service.
DATABASE_URL="postgresql://freelancezero:freelancezero@localhost:5432/freelancezero?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Trust the host header behind a reverse proxy / in Docker.
AUTH_TRUST_HOST="true"

# OAuth providers (optional — leave blank to disable that button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Email (magic links, verification, notifications) ---
# SMTP is the zero-lock-in default. Works with Mailhog locally (see docker-compose).
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="自由工作平台 <no-reply@freelancezero.com>"

# Production email: set RESEND_API_KEY (and leave EMAIL_SERVER_HOST unset) to
# send via Resend. EMAIL_FROM must be on a domain verified in Resend.
# Locally, EMAIL_SERVER_HOST (Mailhog) above takes precedence, so dev never
# sends real mail even if this key is present.
RESEND_API_KEY=""

# --- External-job recruiter outreach (cold-start ingestion) ---
# published_only  = only email addresses the posting actually published
# published_first = published preferred; verified guesses used as a fallback
RECRUITER_OUTREACH_POLICY="published_first"
# Live SMTP RCPT probing during verification. Keep "false" unless you send from a
# dedicated IP — probing from your app IP harms deliverability.
EMAIL_VERIFY_SMTP="false"
# Minimum confidence (0..1) for a *guessed* recruiter address to be contactable.
RECRUITER_MIN_CONFIDENCE="0.7"
# Physical mailing address shown in the recruiter (cold) email footer.
# Required by CAN-SPAM for the one outreach email in this flow.
MAIL_POSTAL_ADDRESS="自由工作平台, 123 Example St, City, Country"
# Shared secret for the cold-start pipeline endpoint (POST /api/cron/ingest).
# Point a scheduler at it: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# --- Storage adapter ---  (local | s3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
# S3 / MinIO (when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="freelancezero"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Realtime adapter ---  (socketio | pusher | none)
REALTIME_DRIVER="none"
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# --- Search adapter ---  (postgres | meilisearch)
SEARCH_DRIVER="postgres"
MEILISEARCH_HOST=""
MEILISEARCH_KEY=""

# --- Payments adapter ---  (manual | alipay | wechat | stripe | paypal)
# The platform NEVER takes a fee. Adapters route funds client -> freelancer.
PAYMENTS_DRIVER="manual"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 支付宝开放平台（PAYMENTS_DRIVER=alipay 时需要；未接入前保持 manual）
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
# 微信支付商户号（PAYMENTS_DRIVER=wechat 时需要）
WECHAT_MCH_ID=""
WECHAT_API_KEY=""

# --- 电子签 ---  (manual | esign | fadada)
# manual = 站内点击签署并记录姓名/时间/IP；生产建议接入 e签宝/法大大。
ESIGN_DRIVER="manual"

# --- Identity verification (KYC) ---
# none | manual | stripe。国内默认 manual：提交真实姓名后由管理员人工审核。
IDENTITY_DRIVER="manual"
# With "stripe", uses Stripe Identity for document + selfie checks (includes
# the QR hand-off to a phone camera) and requires STRIPE_SECRET_KEY on an
# account with Identity enabled. Point the provider's webhook at
# /api/webhooks/identity.

# --- AI 注册初筛（OpenAI 兼容 Chat Completions，默认 DeepSeek）---
# 不填 API Key 时跳过 AI，账号继续进入人工审核队列。
AI_MODERATION_API_KEY=""
AI_MODERATION_BASE_URL="https://api.deepseek.com/v1"
AI_MODERATION_MODEL="deepseek-chat"
